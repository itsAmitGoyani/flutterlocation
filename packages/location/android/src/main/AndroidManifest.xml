<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:name=".FlutterLocationService"/>
        <!-- The wake sources at rest: the leash geofence, the activity
             transitions and the heartbeat alarm (WakeMonitor). -->
        <receiver
            android:enabled="true"
            android:exported="false"
            android:name=".WakeReceiver"/>
        <!-- Restores the foreground service after a reboot or an app update
             when background mode was wanted (FlutterLocationService.restoreIfWanted),
             and arms the wake sources again (WakeMonitor.rearmIfArmed). -->
        <receiver
            android:enabled="true"
            android:exported="true"
            android:name=".FlutterLocationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
